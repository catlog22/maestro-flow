node_modules/
dist/
dist-server/
# Vendored Transformers.js runtime model cache (downloaded at runtime, regenerated on demand)
dashboard/vendor/transformers/.cache/
# The vendored Transformers.js runtime bundle must be committed (exemption from the generic dist/ rule above)
!dashboard/vendor/transformers/dist/
!dashboard/vendor/transformers/dist/**
# Compiled TS artifacts must not live in src/ — source is .ts, build → dist/.
# (Leaked .js/.d.ts/.js.map break tooling and make runners resolve stale code.)
src/**/*.js
src/**/*.js.map
src/**/*.d.ts
!src/types/hono.d.ts
!src/tools/impeccable/live/static/*.js
.tmp/
*.log
# Python bytecode (generated when running skill scripts, e.g. team-adversarial-swarm/scripts)
__pycache__/
*.pyc
.env
.env.*
.DS_Store
Thumbs.db

# Local tool/workflow state (not for distribution)
.ace-tool/
.ccw/
.workflow/
!.workflow/collab/
.workflow/collab/*
!.workflow/collab/overlays/
# 例外：coordinator-tracker 集成测试的 mock fixture 需要入库
!src/hooks/__tests__/fixtures/mock-workspace/.workflow/
!src/hooks/__tests__/fixtures/mock-workspace/.workflow/**
claude-code-skills-guide.md

# Local analysis/research checkouts and reports
_analysis/

# Dashboard local state
dashboard/.planning/
dashboard/.workflow/
dashboard/dist/
dashboard/dist-server/
dashboard/node_modules/
.history
.claude/settings.local.json

# Antigravity CLI auto-creates this for project discovery (empty on Windows without symlink permission)
.antigravitycli/

# Platform mirrors — build artifacts generated from .claude/ at install time.
# Not committed; regenerate via `npm run build:mirrors` before publishing.
.agy/
.agents/

search-cache.json

# Pi platform local config (permissions/model mapping), same nature as .claude/settings.local.json
.pi/

# Local debug screenshots & scratch UI captures (root-level)
/after-click.png
/collapsed.png
/cur-layout.png
/cur2.png
/cur3.png
/editor-win.png
/editor-win2.png
/ws-pop.png
# Packed npm tarballs (local install artifacts)
/maestro-flow-*.tgz
# Windows redirect/pipe artifact
/nul
# Local analysis/research checkouts and reports
/artifacts/
/test-ui/
/ref/sidebar.html
